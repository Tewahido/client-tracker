# Caddy config for hosting the built app (dist/) on a server, e.g. a Hetzner VPS.
# Caddy fetches and renews the HTTPS certificate itself. Replace the domain, copy this
# to /etc/caddy/Caddyfile and run `systemctl reload caddy`. See "Deploying" in README.md.

lendly.example.com {
	root * /var/www/lendly
	encode zstd gzip
	try_files {path} /index.html
	file_server

	# Hashed build files never change; the app shell and service worker must always be
	# fresh, or installed phones can stay on an old version.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@shell path / /index.html /sw.js /manifest.webmanifest /version.json
	header @shell Cache-Control "no-cache"

	header {
		# The build's <meta> Content-Security-Policy can't stop other sites framing the app
		# (clickjacking); only a response header can.
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
