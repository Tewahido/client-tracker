#!/bin/sh
# Runs every project check before anything leaves this machine (see AGENTS.md).
# Installed by `npm install` (the "prepare" script points git at .githooks/).

# Never push to main: changes reach main only through a reviewed pull request.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: pushing to main is not allowed. Push a feature branch and open a pull request." >&2
    exit 1
  fi
done

echo "pre-push: running npm run verify (typecheck, lint, tests-required, tests, audit, build)..."
npm run verify --silent || {
  echo "pre-push: checks failed, nothing was pushed. Fix the problems above and push again." >&2
  exit 1
}
