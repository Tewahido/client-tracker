# Optional: connect Supabase to sync your data across devices.
# Leave these unset and the app stores everything in this browser instead.
# Find both values in Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optional: Web Push public key, so reminders arrive with the app closed (see supabase/functions/README.md).
VITE_VAPID_PUBLIC_KEY=
